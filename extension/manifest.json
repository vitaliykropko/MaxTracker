{
  "manifest_version": 3,
  "name": "MaxTracker Auto",
  "version": "3.2.10",
  "description": "Состояния обращений MAX, учёт времени и обмен через LAN-хаб",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://web.max.ru/*", "http://127.0.0.1/*", "http://localhost/*", "http://192.168.100.90/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker":"background.js"},
  "action": {"default_title":"Настройки MaxTracker", "default_icon":{"48":"icon48.png","128":"icon128.png"}},
  "icons":{"48":"icon48.png","128":"icon128.png"},
  "options_ui":{"page":"options.html","open_in_tab":true},
  "content_scripts":[
    {"matches":["https://web.max.ru/*"],"js":["max-bridge.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://web.max.ru/*"],"js":["content.js"],"css":["content.css"],"run_at":"document_start","world":"ISOLATED"}
  ]
}
